# Backend Configuration
REDIS_URL=redis://redis:6379/0
PREP_REVIEW_PROCESSOR=rule_engine.jobs:process_review

# Supabase Configuration (Backend & Migrations)
# SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=your_supabase_project_url
# SUPABASE_KEY / SUPABASE_SERVICE_ROLE_KEY: Service role key for backend operations (never sent to client)
SUPABASE_KEY=your_supabase_service_role_key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL: Required for client & SSR auth
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (or NEXT_PUBLIC_SUPABASE_ANON_KEY): Required publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_ENABLE_LAB=true

# Local development fake role (operator | reviewer | manager | admin).
# COMMENTED OUT BY DEFAULT: Copying this file will NOT enable fake auth.
# DEV_FAKE_ROLE only works if NEXT_PUBLIC_APP_ENV === 'local' AND NODE_ENV !== 'production'.
# DEV_FAKE_ROLE=operator
